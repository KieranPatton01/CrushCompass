rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles: only user1 and user2 can read/write
    match /users/{userId} {
      allow read, write: if userId == "user1" || userId == "user2";
    }

    // Shared session document: both users can read/write
    match /sessions/main {
      allow read, write: if true;
    }
  }
}
